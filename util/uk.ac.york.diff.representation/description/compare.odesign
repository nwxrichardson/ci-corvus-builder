          <subNodeMappings name="Left Graphical Node: psl.tasks.taskNode" preconditionExpression="aql:containerView.isGraphicalDiff()" semanticCandidatesExpression="aql:self" domainClass="corvusmatch::Match">
            <style xsi:type="style:SquareDescription" labelSize="12" labelExpression="aql:'old'" labelPosition="node" resizeKind="NSEW" color="//@userColorsPalettes[name='Custom%20Palette']/@entries[name='Task%20Colour']">
