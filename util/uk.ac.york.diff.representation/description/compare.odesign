              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <forbiddenSides>NORTH</forbiddenSides>
              <forbiddenSides>SOUTH</forbiddenSides>
              <forbiddenSides>EAST</forbiddenSides>
            </style>
          </subNodeMappings>
          <subNodeMappings name="Right Graphical Node: psl.tasks.taskNode" preconditionExpression="aql:containerView.isGraphicalDiff()" semanticCandidatesExpression="aql:self" domainClass="corvusmatch::Match">
            <style xsi:type="style:SquareDescription" labelSize="12" labelExpression="aql:'new'" labelPosition="node" resizeKind="NSEW" color="//@userColorsPalettes[name='Custom%20Palette']/@entries[name='Task%20Colour']">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <forbiddenSides>NORTH</forbiddenSides>
              <forbiddenSides>SOUTH</forbiddenSides>
              <forbiddenSides>WEST</forbiddenSides>
            </style>
          </subNodeMappings>
        </containerMappings>
      </additionalLayers>
