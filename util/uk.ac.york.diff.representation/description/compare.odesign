              </style>
            </conditionalStyles>
            <conditionalStyles predicateExpression="aql:self.kind.toString() = 'DELETE' and self.state.toString() = 'SHOWREJECT'">
              <style labelExpression="aql:self.diffLabel()" iconPath="/uk.ac.york.corvus/icons/showReject.png">
                <labelFormat>bold</labelFormat>
                <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
                <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_red']"/>
              </style>
            </conditionalStyles>
            <conditionalStyles predicateExpression="aql:self.kind.toString() = 'CHANGE' and self.state.toString() = 'SHOWREJECT'">
              <style labelExpression="aql:self.diffLabel()" iconPath="/uk.ac.york.corvus/icons/showReject.png">
                <labelFormat>bold</labelFormat>
                <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
                <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_purple']"/>
              </style>
            </conditionalStyles>
            <conditionalStyles predicateExpression="aql:self.kind.toString() = 'MOVE' and self.state.toString() = 'SHOWREJECT'">
              <style labelExpression="aql:self.diffLabel()" iconPath="/uk.ac.york.corvus/icons/showReject.png">
                <labelFormat>bold</labelFormat>
                <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
                <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_blue']"/>
              </style>
            </conditionalStyles>
            <popupMenus name="Merge">
              <menuItemDescriptions xsi:type="tool:OperationAction" name="Accept" forceRefresh="true" icon="/uk.ac.york.corvus/icons/tick.png">
                <view name="views"/>
                <initialOperation>
                  <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:self.accept()"/>
                </initialOperation>
              </menuItemDescriptions>
              <menuItemDescriptions xsi:type="tool:OperationAction" name="Reject" icon="/uk.ac.york.corvus/icons/rejectDnx.png">
                <view name="views"/>
                <initialOperation>
                  <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:self.decline()"/>
                </initialOperation>
              </menuItemDescriptions>
              <menuItemDescriptions xsi:type="tool:OperationAction" name="Show" icon="/uk.ac.york.corvus/icons/showBoth.png">
                <view name="views"/>
                <initialOperation>
                  <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:self.show()"/>
                </initialOperation>
              </menuItemDescriptions>
              <menuItemDescriptions xsi:type="tool:OperationAction" name="Show Accept" icon="/uk.ac.york.corvus/icons/showAccept.png">
                <view name="views"/>
                <initialOperation>
                  <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:self.showAccept()"/>
                </initialOperation>
              </menuItemDescriptions>
              <menuItemDescriptions xsi:type="tool:OperationAction" name="Show Reject" icon="/uk.ac.york.corvus/icons/showReject.png">
                <view name="views"/>
                <initialOperation>
                  <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:self.showReject()"/>
                </initialOperation>
              </menuItemDescriptions>
              <menuItemDescriptions xsi:type="tool:OperationAction" name="Reset" forceRefresh="true" icon="/uk.ac.york.corvus/icons/reset.png">
                <view name="views"/>
                <initialOperation>
                  <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:self.match.clearDeltas()"/>
                </initialOperation>
              </menuItemDescriptions>
              <menuItemDescriptions xsi:type="tool:OperationAction" name="Test">
                <view name="views"/>
                <initialOperation>
                  <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:self.test()"/>
                </initialOperation>
              </menuItemDescriptions>
            </popupMenus>
          </subItemMappings>
          <popupMenus name="Merge">
            <menuItemDescriptions xsi:type="tool:OperationAction" name="Reset" forceRefresh="true" icon="/uk.ac.york.corvus/icons/reset.png">
              <view name="views"/>
              <initialOperation>
                <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:self.clearDeltas()"/>
              </initialOperation>
            </menuItemDescriptions>
          </popupMenus>
        </subItemMappings>
        <subItemMappings name="Merge Set Options" domainClass="corvusmatch::MergeSet" preconditionExpression="aql:self.toShow" semanticCandidatesExpression="aql:self.mergeSets">
          <defaultStyle labelExpression="Merge Set">
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
          </defaultStyle>
          <conditionalStyles predicateExpression="aql: self.isPurple()">
            <style labelExpression="Merge Set">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_purple']"/>
            </style>
          </conditionalStyles>
          <conditionalStyles predicateExpression="aql: self.isOrange()">
            <style labelExpression="Merge Set">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_orange']"/>
            </style>
          </conditionalStyles>
          <conditionalStyles predicateExpression="aql: self.isYellow()">
            <style labelExpression="Merge Set">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_yellow']"/>
            </style>
          </conditionalStyles>
          <subItemMappings name="Accept" domainClass="corvusmatch::DiffSet" semanticCandidatesExpression="aql:self.toAccept" reusedTreeItemMappings="//@ownedViewpoints[name='Match%20MyViewpoint']/@ownedRepresentations[name='Compare%20Tree']/@subItemMappings[name='Comparison']/@subItemMappings[name='Match']/@subItemMappings[name='Diff']">
            <defaultStyle labelExpression="Accept">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
            </defaultStyle>
          </subItemMappings>
          <subItemMappings name="Reject" domainClass="corvusmatch::DiffSet" semanticCandidatesExpression="aql:self.toReject" reusedTreeItemMappings="//@ownedViewpoints[name='Match%20MyViewpoint']/@ownedRepresentations[name='Compare%20Tree']/@subItemMappings[name='Comparison']/@subItemMappings[name='Match']/@subItemMappings[name='Diff']">
            <defaultStyle labelExpression="Reject">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
            </defaultStyle>
          </subItemMappings>
          <popupMenus name="Merge">
            <menuItemDescriptions xsi:type="tool:OperationAction" name="Select Merge Set">
              <view name="views"/>
              <initialOperation>
                <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:self.selectMergeSet()"/>
              </initialOperation>
            </menuItemDescriptions>
            <menuItemDescriptions xsi:type="tool:OperationAction" name="Show Merge Set">
              <view name="views"/>
              <initialOperation>
                <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:self.showMergeSet()"/>
              </initialOperation>
            </menuItemDescriptions>
            <menuItemDescriptions xsi:type="tool:OperationAction" name="Reject Merge Set">
              <view name="views"/>
              <initialOperation>
                <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:self.rejectMergeSet()"/>
              </initialOperation>
            </menuItemDescriptions>
            <menuItemDescriptions xsi:type="tool:OperationAction" name="Reset Merge Sets">
              <view name="views"/>
              <initialOperation>
                <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql: self.resetMergeSets()"/>
              </initialOperation>
            </menuItemDescriptions>
          </popupMenus>
        </subItemMappings>
        <popupMenus name="Comparison Menu">
          <menuItemDescriptions xsi:type="tool:OperationAction" name="Expand All">
            <view name="views"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:views.toggleTreeItems(true)"/>
            </initialOperation>
          </menuItemDescriptions>
          <menuItemDescriptions xsi:type="tool:OperationAction" name="Collapse All">
            <view name="views"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:views.toggleTreeItems(false)"/>
            </initialOperation>
          </menuItemDescriptions>
        </popupMenus>
      </subItemMappings>
    </ownedRepresentations>
    <ownedJavaExtensions qualifiedClassName="psl.design.Services"/>
    <ownedJavaExtensions qualifiedClassName="uk.ac.york.corvus.extensions.MatchExtension"/>
  </ownedViewpoints>
  <userColorsPalettes name="Custom Palette">
    <entries xsi:type="description:UserFixedColor" red="181" green="254" blue="254" name="Task Colour"/>
    <entries xsi:type="description:UserFixedColor" red="254" green="255" blue="180" name="Person Colour"/>
    <entries xsi:type="description:UserFixedColor" red="244" green="222" blue="169" name="Effort Colour"/>
    <entries xsi:type="description:UserFixedColor" red="201" green="230" blue="182" name="Deliverable Colour"/>
  </userColorsPalettes>
</description:Group>
